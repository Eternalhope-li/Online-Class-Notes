<?xml version="1.0" encoding="utf-8"?>
<!-- 一行笔记：左边时间戳，右边正文。正文是文字就是一句话，是截图就是「大图 + 说明 + 分析按钮」 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/time"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:alpha="0.55"
        android:fontFamily="monospace"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/shotBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/shot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:adjustViewBounds="true"
                android:background="#14000000"
                android:contentDescription="@string/entry_shot_open"
                android:minHeight="130dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/shotCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:lineSpacingExtra="3dp"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnAnalyze"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_shot_action"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/entry_shot_analyze"
                android:textColor="@color/brand"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="@string/tag_important"
        android:textColor="@color/star"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
