<?xml version="1.0" encoding="utf-8"?>
<!--
  横屏（平板横过来）用的整理稿页：把这一页拆成左右两块，而不是一条压扁的长条。

  左边是「本页目录」，右边是笔记正文。竖屏时目录是一条压在正文最上面的卡片，
  横过来之后正文只剩下半屏高、却宽到一行能放八十字，眼睛要横着扫很久，
  于是目录改成常驻侧栏：跳小节的入口一直在手边，正文则铺满右边剩下的地方（最多 900dp）。
  侧栏只列小节名，收在 200dp —— 它占得越少，正文越充分。

  上方那行「状态 + 重新整理」在两栏时也整行收进工具栏（状态变副标题、按钮变成一个菜单项）：
  横过来的屏幕只有六七百 dp 高，省下的每一行都是正文。

  这一份必须和 layout/activity_digest.xml 的 id 保持一致（两份合并成一个 ViewBinding 类），
  tocPane / sidePane 只在这份里，代码里按可空处理。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/digest_title"
        app:menu="@menu/digest"
        app:navigationIconTint="?attr/colorOnSurface" />

    <!--
      手机横过来（窄到放不下两栏）时这行还在：状态和按钮并成一行。
      平板那种真正的两栏会把它整行收进工具栏，见代码里的 applyTopRow。
    -->
    <LinearLayout
        android:id="@+id/statusRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:alpha="0.7"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAi"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:minWidth="0dp"
            android:text="@string/digest_ai_do"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/staleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/staleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/digest_stale"
            android:textSize="12.5sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStaleUpdate"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:text="@string/digest_stale_update"
            android:textSize="12.5sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- 目录侧栏：只有正文分出了三节以上才有内容，代码里看着它有没有子 View 决定显不显示 -->
            <LinearLayout
                android:id="@+id/sidePane"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <ScrollView
                    android:id="@+id/tocScroll"
                    android:layout_width="200dp"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="12dp"
                    android:scrollbarStyle="outsideOverlay">

                    <LinearLayout
                        android:id="@+id/tocPane"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="24dp" />
                </ScrollView>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="?attr/colorSurfaceVariant" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:scrollbarStyle="outsideOverlay">

                <LinearLayout
                    android:id="@+id/column"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/contentBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="32dp" />

                    <TextView
                        android:id="@+id/content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="5dp"
                        android:paddingBottom="24dp"
                        android:textIsSelectable="true"
                        android:textSize="13.5sp"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/digest_empty"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
